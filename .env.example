# Filled in by `shopify app dev`; set by hand for a real deployment.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_orders

# Local development uses SQLite. Swap the provider in prisma/schema.prisma to
# "postgresql" and put a connection string here when this moves to a server.
# Postgres connection string. For testing: Vercel → Storage → Prisma Postgres (free).
DATABASE_URL="postgres://user:password@host:5432/giftflow"

# Signs the gift tokens that travel in cart line item properties.
GIFT_TOKEN_SECRET=

# Where uploaded card images and rendered PDFs are written. A local folder in
# development; swap for object storage before this serves real traffic.
STORAGE_DIR="./storage"

# Billing. "on" charges through the Shopify Billing API (test charges outside
# production). "off" gives every shop the top plan — use it for a private,
# single-store install such as the original Slikekspressen store.
GIFTFLOW_BILLING="on"
